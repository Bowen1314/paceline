# Paceline configuration. Copy to .env (git-ignored) and run with
#   node --env-file=.env dist/server/index.js
# or pass the same names with `docker run -e` / `--env-file`.
#
# Paceline reads ONLY these names. Generic names such as LLM_API_KEY,
# OPENAI_API_KEY or LLM_BASE_URL are never read, even if they are set.
# Key-like variables are removed from the process environment right after
# start-up, so nothing the server starts can inherit them.

# ---------------------------------------------------------------- PayPal
# simulator (default): in-memory PayPal, signed fake webhooks, no network.
# sandbox: real calls to api-m.sandbox.paypal.com. Needs all three PAYPAL_*
#          values below and refuses to start without them (no fallback).
PACELINE_PAYPAL_MODE=simulator
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id PayPal shows for the webhook you registered (Developer Dashboard > your app > Webhooks).
PAYPAL_WEBHOOK_ID=
# Sandbox mode: every invoice is addressed to this sandbox personal (buyer) account,
# whatever email the brief contains.
PACELINE_SANDBOX_BUYER_EMAIL=
# Optional guards. If set, they must say sandbox, or the server refuses to start.
# PACELINE_PAYPAL_HOST=api-m.sandbox.paypal.com
# PACELINE_PAYPAL_ENVIRONMENT=sandbox

# Who gets the live sandbox (sandbox mode only).
#   everyone: every visitor's workspace is live. Only allowed when PACELINE_PUBLIC_URL
#             is unset or local; a public URL with implicit `everyone` refuses to start.
#   operator: visitors get the simulator; one browser unlocks the live sandbox at
#             /operator with the token below (or a pairing code approved with it).
# Default: operator when PACELINE_OPERATOR_TOKEN is set, else everyone.
# PACELINE_SANDBOX_ACCESS=operator
# At least 24 printable characters, no spaces. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PACELINE_OPERATOR_TOKEN=
# PayPal reads invoice dates in the merchant's time zone; a date after the merchant's
# "today" makes send return SCHEDULED and remind/cancel fail. Default America/Los_Angeles.
# PACELINE_TIMEZONE=America/Los_Angeles

# ---------------------------------------------------------------- planner model
# auto (default): Nemotron on Nebius when NEBIUS_API_KEY is set, else the scripted planner.
# scripted: never call a model. nebius: require the key.
PACELINE_PLANNER=auto
NEBIUS_API_KEY=
# PACELINE_MODEL=nvidia/nemotron-3-super-120b-a12b
# Spend guard for the model (kept in DATA_DIR/model-budget.json, resets each UTC day).
# When a limit is reached the rule-based planner and prose templates take over.
# PACELINE_MODEL_DAILY_USD=0.25
# PACELINE_MODEL_DAILY_CALLS=300
# PACELINE_MODEL_RUNS_PER_IP_HOUR=20

# ---------------------------------------------------------------- AG Grid
# Optional Enterprise licence key. Served to the page at request time; never
# commit it and never bake it into a build. Without it AG Grid runs in trial mode.
PACELINE_AG_GRID_LICENSE_KEY=

# ---------------------------------------------------------------- server
# PACELINE_PORT wins over PORT; default 8791.
PACELINE_PORT=8791
# 127.0.0.1 by default; the Docker image sets 0.0.0.0.
PACELINE_HOST=127.0.0.1
PACELINE_DATA_DIR=data
# Public https origin when deployed (secure cookies, allowed Origin for POSTs).
# PACELINE_PUBLIC_URL=https://paceline.example.com
# 1 = trust X-Forwarded-For from the reverse proxy for per-IP rate limits.
# PACELINE_TRUST_PROXY=0
# PACELINE_MAX_AGENT_RUNS=2
# PACELINE_MAX_WORKSPACES=200
# PACELINE_MAX_SSE_CLIENTS=300
